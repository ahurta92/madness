dft
    convergence.criteria [bsh_residual, density_change, energy_change]
    convergence.bsh_residual 0.0005
    convergence.density_change 0.0001
    convergence.energy_change 1e-05
    dipole true
    l 100.0
    localize "canon"
    maxiter 30
    print_level 10
    protocol [1e-1,1e-2,1e-4]
    xc "hf"
end
response
    dipole true
    dipole.directions z
    dipole.frequencies [0.0]
    excited.enable true
    excited.num_states 2
    excited.tda false
    maxiter 20
    excited.maxsub 4
    print_level 2
end
molecule
    eprec 1e-5
    units angstrom
    H 0.000000000000 0.000000000000 -0.370000000000
    H 0.000000000000 0.000000000000 0.370000000000
end
