# raman.nuc_atom beyond the molecule's atom count must be refused before any solve (review C13)
#
# Refusal case: check.json expect_error; no reference. Run: ./run.sh

dft
    convergence.bsh_residual 0.0005
    convergence.density_change 0.0001
    convergence.energy_change 0.0001
    xc        hf
    k         6
    protocol  [1e-4]
    maxiter   20
end

response
    dipole                true
    dipole.directions     z
    dipole.frequencies    [0.0]
    requested_properties  [polarizability, raman]
    raman.nuc_atom        3
    raman.nuc_axis        2
    convergence.bsh_residual 0.005
    convergence.density_change 0.005
    convergence.energy_change 0.005
end

molecule
    units   atomic
    eprec   1e-6
    He  0.0  0.0  0.0
end
