# beta on a DFT ground state needs g''_xc, which is not implemented; refused since the f_xc merge
#
# Refusal case: check.json expect_error; no reference. Run: ./run.sh

dft
    convergence.bsh_residual 0.0005
    convergence.density_change 0.0001
    convergence.energy_change 0.0001
    xc        lda
    k         6
    protocol  [1e-4]
    maxiter   20
end

response
    dipole              true
    dipole.directions   z
    dipole.frequencies  [0.0]
    quadratic           true
    convergence.bsh_residual 0.0005
    convergence.density_change 0.0005
    convergence.energy_change 0.0005
end

molecule
    units   atomic
    eprec   1e-6
    He  0.0  0.0  0.0
end
